{
  "metadata": {
    "title": "Elasticsearch Jira-gRPC Index Mapping, Analyzers & RAG Tuning Benchmark Suite",
    "target_index": "jira-grpc-issues",
    "bulk_data_file": "grpc_jira_issues_es_bulk.ndjson",
    "source_repository": "https://github.com/grpc/grpc/issues",
    "total_documents": 20
  },
  "index_creation_request": {
    "endpoint": "PUT /jira-grpc-issues",
    "body": {
      "settings": {
        "number_of_shards": 1,
        "number_of_replicas": 1,
        "similarity": {
          "bm25_short_field": {
            "type": "BM25",
            "k1": 1.2,
            "b": 0.3
          },
          "bm25_long_text": {
            "type": "BM25",
            "k1": 1.5,
            "b": 0.75
          }
        },
        "analysis": {
          "char_filter": {
            "preserve_code_symbols": {
              "type": "mapping",
              "mappings": [
                ":: => _coloncolon_",
                "__ => _dunder_"
              ]
            }
          },
          "tokenizer": {
            "code_identifier_tokenizer": {
              "type": "pattern",
              "pattern": "([^a-zA-Z0-9_.\\-:/]+)"
            }
          },
          "filter": {
            "grpc_synonym_filter": {
              "type": "synonym",
              "synonyms": [
                "statuscode.unavailable, grpc_status 14, unavailable, 503",
                "statuscode.unknown, grpc_status 2, unknown",
                "statuscode.deadline_exceeded, grpc_status 4, deadline exceeded, timeout",
                "statuscode.unauthenticated, grpc_status 16, unauthenticated, 401",
                "statuscode.cancelled, grpc_status 1, channel closed",
                "cares, c-ares, ares_resolver, grpc_ares_wrapper"
              ]
            }
          },
          "analyzer": {
            "grpc_code_analyzer": {
              "type": "custom",
              "char_filter": ["preserve_code_symbols"],
              "tokenizer": "code_identifier_tokenizer",
              "filter": ["lowercase", "grpc_synonym_filter"]
            },
            "rag_text_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "stop", "snowball", "grpc_synonym_filter"]
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "issue_key": { "type": "keyword" },
          "github_issue_number": { "type": "integer" },
          "project": {
            "properties": {
              "key": { "type": "keyword" },
              "name": { "type": "keyword" }
            }
          },
          "issue_type": { "type": "keyword" },
          "status": { "type": "keyword" },
          "priority": { "type": "keyword" },
          "resolution": { "type": "keyword" },
          "components": {
            "type": "keyword",
            "fields": {
              "text": { "type": "text", "analyzer": "rag_text_analyzer" }
            }
          },
          "labels": { "type": "keyword" },
          "language": {
            "type": "keyword",
            "fields": {
              "text": { "type": "text", "analyzer": "standard" }
            }
          },
          "affected_versions": { "type": "keyword" },
          "fix_versions": { "type": "keyword" },
          "environment": {
            "properties": {
              "os": { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
              "runtime": { "type": "text", "analyzer": "grpc_code_analyzer" },
              "deployment": { "type": "text", "fields": { "keyword": { "type": "keyword" } } }
            }
          },
          "reporter": { "type": "keyword" },
          "assignee": { "type": "keyword" },
          "participants": { "type": "keyword" },
          "created_at": { "type": "date" },
          "updated_at": { "type": "date" },
          "resolved_at": { "type": "date" },
          "summary": {
            "type": "text",
            "analyzer": "rag_text_analyzer",
            "similarity": "bm25_short_field",
            "fields": {
              "code": { "type": "text", "analyzer": "grpc_code_analyzer" },
              "keyword": { "type": "keyword" }
            }
          },
          "error_signature": {
            "type": "text",
            "analyzer": "grpc_code_analyzer",
            "similarity": "bm25_short_field",
            "fields": {
              "raw": { "type": "keyword", "ignore_above": 1024 }
            }
          },
          "description": {
            "type": "text",
            "analyzer": "rag_text_analyzer",
            "similarity": "bm25_long_text",
            "fields": {
              "code": { "type": "text", "analyzer": "grpc_code_analyzer" }
            }
          },
          "steps_to_reproduce": {
            "type": "text",
            "analyzer": "rag_text_analyzer"
          },
          "root_cause": {
            "type": "text",
            "analyzer": "rag_text_analyzer",
            "similarity": "bm25_long_text",
            "fields": {
              "code": { "type": "text", "analyzer": "grpc_code_analyzer" }
            }
          },
          "workaround_or_fix": {
            "type": "text",
            "analyzer": "rag_text_analyzer",
            "similarity": "bm25_long_text",
            "fields": {
              "code": { "type": "text", "analyzer": "grpc_code_analyzer" }
            }
          },
          "comments": {
            "type": "nested",
            "properties": {
              "author": { "type": "keyword" },
              "role": { "type": "keyword" },
              "created_at": { "type": "date" },
              "body": {
                "type": "text",
                "analyzer": "rag_text_analyzer",
                "fields": {
                  "code": { "type": "text", "analyzer": "grpc_code_analyzer" }
                }
              }
            }
          },
          "rag_chunk_text": {
            "type": "text",
            "analyzer": "rag_text_analyzer",
            "fields": {
              "code": { "type": "text", "analyzer": "grpc_code_analyzer" }
            }
          },
          "rag_embedding": {
            "type": "dense_vector",
            "dims": 1024,
            "index": true,
            "similarity": "cosine"
          },
          "source_url": { "type": "keyword" }
        }
      }
    }
  },
  "rag_search_query_templates": {
    "1_lexical_bm25_boosted_query": {
      "description": "Multi-match BM25 query with field boosting tuned for technical Jira issues (error_signature^4, summary^3, root_cause^2.5, workaround_or_fix^2, description^1)",
      "endpoint": "POST /jira-grpc-issues/_search",
      "body": {
        "size": 5,
        "query": {
          "bool": {
            "should": [
              {
                "multi_match": {
                  "query": "hpack_parser.cc content-type invalid value StatusCode.UNKNOWN Stream removed",
                  "type": "best_fields",
                  "fields": [
                    "error_signature^4.0",
                    "summary^3.0",
                    "summary.code^3.5",
                    "root_cause^2.5",
                    "root_cause.code^2.5",
                    "workaround_or_fix^2.0",
                    "description^1.0",
                    "rag_chunk_text^1.5"
                  ],
                  "tie_breaker": 0.3
                }
              },
              {
                "nested": {
                  "path": "comments",
                  "score_mode": "max",
                  "query": {
                    "multi_match": {
                      "query": "hpack_parser.cc content-type invalid value",
                      "fields": ["comments.body^1.5", "comments.body.code^2.0"]
                    }
                  },
                  "inner_hits": { "size": 2 }
                }
              }
            ]
          }
        }
      }
    },
    "2_hybrid_rrf_knn_plus_bm25": {
      "description": "Reciprocal Rank Fusion (RRF) combining BM25 lexical precision on error signatures with dense_vector kNN semantic retrieval on rag_embedding",
      "endpoint": "POST /jira-grpc-issues/_search",
      "body": {
        "retriever": {
          "rrf": {
            "retrievers": [
              {
                "standard": {
                  "query": {
                    "bool": {
                      "filter": [
                        { "term": { "project.key": "GRPC" } }
                      ],
                      "must": [
                        {
                          "multi_match": {
                            "query": "keepalive watchdog timeout while receiving data on slow network",
                            "fields": [
                              "error_signature^4.0",
                              "summary^3.0",
                              "root_cause^2.5",
                              "workaround_or_fix^2.0",
                              "rag_chunk_text^1.5"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "knn": {
                  "field": "rag_embedding",
                  "query_vector": "[0.012, -0.034, ... 1024-dim embedding vector]",
                  "k": 10,
                  "num_candidates": 50
                }
              }
            ],
            "rank_window_size": 20,
            "rank_constant": 60
          }
        }
      }
    }
  },
  "rag_evaluation_ground_truth": [
    {
      "query_id": "Q01",
      "query": "hpack_parser.cc:993 Error parsing 'content-type' metadata: invalid value 에러와 함께 StatusCode.UNKNOWN Stream removed가 발생하는 원인과 해결 방법은?",
      "expected_issue_keys": ["GRPC-34076", "GRPC-36328"],
      "tuning_focus": "Code tokenizer preservation of 'hpack_parser.cc:993' and 'content-type' + high boost on error_signature"
    },
    {
      "query_id": "Q02",
      "query": "느린 네트워크에서 서버로부터 데이터를 실제로 수신 중인데도 클라이언트에서 keepalive watchdog timeout이 발생하는 원인은?",
      "expected_issue_keys": ["GRPC-22963"],
      "tuning_focus": "Cross-lingual semantic embedding retrieval on root_cause (chttp2_transport.cc keepalive_ping_timer vs watchdog timer)"
    },
    {
      "query_id": "Q03",
      "query": "Python grpcio 1.62.1 서버가 멈추고 connection attempt timed out before receiving SETTINGS frame 에러가 발생할 때 패치 버전은?",
      "expected_issue_keys": ["GRPC-36256"],
      "tuning_focus": "Metadata filter on affected_versions ('1.62.1') + retrieval of fix_versions ('1.62.2')"
    },
    {
      "query_id": "Q04",
      "query": "VPN이나 Ubuntu Conda 환경에서 C-ares status is not ARES_SUCCESS DNS 조회 실패가 날 때 공통 환경변수 해결 방법은?",
      "expected_issue_keys": ["GRPC-40574", "GRPC-34709", "GRPC-34669", "GRPC-24662"],
      "tuning_focus": "Multi-document recall for 'GRPC_DNS_RESOLVER=native' across DNS resolver issues"
    },
    {
      "query_id": "Q05",
      "query": "DNS 서버가 IPv6 AAAA 쿼리에 응답하지 않을 때 gRPC 연결이 20초 이상 지연되는 이유와 타임아웃 설정 파라미터는?",
      "expected_issue_keys": ["GRPC-35638"],
      "tuning_focus": "Matching 'AAAA query', 'ares_gethostbyname', and 'GRPC_ARG_DNS_ARES_QUERY_TIMEOUT_MS'"
    },
    {
      "query_id": "Q06",
      "query": "GCP IAP(Identity-Aware Proxy) 뒤의 gRPC 서버가 401 응답 시 Bad GRPC frame type 0x49 및 StatusCode.UNKNOWN을 반환할 때 클라이언트 인터셉터 우회 코드는?",
      "expected_issue_keys": ["GRPC-36328"],
      "tuning_focus": "Nested comment search (inner_hits) to retrieve 'x-goog-iap-generated-response' and IAPErrorInterceptor"
    },
    {
      "query_id": "Q07",
      "query": "C++ 동기(Synchronous) 서버/클라이언트에서 keepalive timeout을 2초로 설정하면 10분마다 연결이 끊기며 eventfd/eventpoll FD 누수가 발생하는 이유는?",
      "expected_issue_keys": ["GRPC-22698"],
      "tuning_focus": "Matching root_cause (~5s background thread polling interval vs 2000ms keepalive timeout)"
    },
    {
      "query_id": "Q08",
      "query": "Python grpc.aio 양방향 스트리밍(stream-stream)에서 UNIMPLEMENTED 대신 StatusCode.INTERNAL Failed execute_batch SendMessageOperation이 발생하는 이유는?",
      "expected_issue_keys": ["GRPC-36066"],
      "tuning_focus": "Exact token match on 'execute_batch', 'SendMessageOperation', and 'grpc.aio'"
    },
    {
      "query_id": "Q09",
      "query": "Kubernetes에서 서비스 재배포로 Pod IP가 바뀐 뒤 첫 호출이 DNS 재조회 직후 재시도 없이 Failed to pick subchannel (Unavailable)로 실패하는 이유와 해결책은?",
      "expected_issue_keys": ["GRPC-28870"],
      "tuning_focus": "Retrieving pick_first TRANSIENT_FAILURE behavior and ServiceConfig retryPolicy / WaitForReady"
    },
    {
      "query_id": "Q10",
      "query": "프로덕션에서 gRPC client keepalive를 활성화하거나 비활성화할 때 transport is closing 에러를 피하기 위한 서버/클라이언트 배포 순서는?",
      "expected_issue_keys": ["GRPC-25713"],
      "tuning_focus": "Passage retrieval from description and workaround_or_fix regarding deployment order"
    }
  ]
}
